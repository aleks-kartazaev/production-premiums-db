// DBML schema для «Учёт выработки и премий»
// Вставить в dbdiagram.io

Table employees {
  id            serial      [pk]
  full_name     varchar(255) [not null]
  position      varchar(255) [not null]
  hire_date     date        [not null]
  role          varchar(50)  [not null, note: 'master | site_manager | employee | norm_admin']
  is_active     boolean     [not null, default: true]
  created_at    timestamp   [not null, default: `now()`]
  updated_at    timestamp   [not null, default: `now()`]
}

Table items {
  id        serial       [pk]
  name      varchar(255) [not null]
  item_type varchar(255)
  is_active boolean      [not null, default: true]
}

Table norms {
  id                  serial        [pk]
  item_id             integer       [not null, ref: > items.id]
  norm_hours_per_item numeric(10,2) [not null]
  valid_from          date          [not null]
  valid_to            date
  version             integer       [not null, default: 1]
}

Table productivity {
  id          serial        [pk]
  employee_id integer       [not null, ref: > employees.id]
  item_id     integer       [not null, ref: > items.id]
  month       char(7)       [not null]
  items_count integer       [not null, default: 0]
  fact_hours  numeric(10,2) [not null, default: 0]
  norm_hours  numeric(10,2)
  ratio       numeric(10,4)
  created_at  timestamp     [not null, default: `now()`]
  updated_at  timestamp     [not null, default: `now()`]

  indexes {
    (employee_id, item_id, month) [unique]
  }
}

Table bonus_coefficients {
  id            serial        [pk]
  ratio_from    numeric(10,4) [not null]
  ratio_to      numeric(10,4) [not null]
  bonus_percent numeric(5,2)  [not null]
  valid_from    date          [not null]
  valid_to      date
}

Table bonus_accruals {
  id                   serial        [pk]
  employee_id          integer       [not null, ref: > employees.id]
  month                char(7)       [not null]
  ratio                numeric(10,4)
  bonus_coefficient_id integer       [ref: > bonus_coefficients.id]
  bonus_percent        numeric(5,2)
  bonus_amount         numeric(12,2)
  status               varchar(20)   [not null, default: 'draft', note: 'draft | approved | adjusted']
  approved_by          integer       [ref: > employees.id]
  approved_at          timestamp
  adjustment_reason    text

  indexes {
    (employee_id, month) [unique]
  }
}

Table periods {
  id        serial      [pk]
  month     char(7)     [not null, unique]
  status    varchar(20) [not null, default: 'open', note: 'open | closed']
  closed_by integer     [ref: > employees.id]
  closed_at timestamp
}

Table audit_log {
  id         serial      [pk]
  entity     varchar(50) [not null]
  entity_id  integer     [not null]
  action     varchar(20) [not null, note: 'create | update | delete']
  changed_by integer     [ref: > employees.id]
  changed_at timestamp   [not null, default: `now()`]
  old_value  jsonb
  new_value  jsonb

  indexes {
    (entity, entity_id)
  }
}

// Связи, которые не выражаются через ref (логические)
// productivity N:1 bonus_coefficients через расчёт ratio
// periods 1:N productivity через month (по значению, не по FK)